# Copy to .env and adjust. docker-compose reads these.

# Secret used to sign anonymous identity tokens. CHANGE THIS in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# How long (ms) a disconnected player's seat is held before the game is abandoned.
RECONNECT_GRACE_MS=60000

# Origin allowed by the server's CORS policy (where the client is served from).
CLIENT_ORIGIN=http://localhost:8080

# Base URL the browser uses to reach the server (baked into the client at build time).
VITE_SERVER_URL=http://localhost:3001
