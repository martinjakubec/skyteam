# Copy to .env and adjust. docker-compose reads these.

# Secret used to sign anonymous identity tokens. Anyone who knows it can take over
# any player's seat. Generate one with:  openssl rand -hex 32
# The production server (NODE_ENV=production, as in the Docker image) refuses to
# start with this placeholder, the dev default, or anything under 32 characters.
JWT_SECRET=change-me-to-a-long-random-string

# How long (ms) a disconnected player's seat is held before the game is abandoned.
RECONNECT_GRACE_MS=60000

# Browser origins allowed by the server's CORS policy. Use "*" to reflect any
# origin (LAN/dev), or a comma-separated allowlist (e.g. http://a:5173,http://b).
# In production it must be set, and "*" is refused.
CLIENT_ORIGIN=http://localhost:8080

# How the browser reaches the server. Leave VITE_SERVER_URL unset to derive it
# from the page's own address (works for localhost and LAN); set it to pin an
# explicit URL. VITE_SERVER_PORT overrides just the port when deriving (default 3001).
# VITE_SERVER_URL=http://localhost:3001
# VITE_SERVER_PORT=3001

# Search worker threads for the Aviator bot. Set it to the CPUs the server may
# really use (e.g. a 2-vCPU VPS: 1). Unset = a spare core each, at most 4,
# counted from the host's cores, which can exceed a container's CPU limit.
# NPC_WORKERS=1
