# Copy to .env and adjust. docker-compose reads these.
# What production needs, and what goes into GitHub: docs/production-variables.md

# Secret used to sign anonymous identity tokens. Anyone who knows it can take over
# any player's seat. Generate one with:  openssl rand -hex 32
# The production server (NODE_ENV=production, as in the Docker image) refuses to
# start with this placeholder, the dev default, or anything under 32 characters.
JWT_SECRET=change-me-to-a-long-random-string

# Signs sign-in sessions (the account cookie). Must differ from JWT_SECRET, so a
# player's identity token can never pass as a session. Generate with:
#   openssl rand -hex 32
# Production refuses a missing, placeholder or short one.
SESSION_SECRET=change-me

# The site owner's account: created on first start as SUPERADMIN (can manage
# users and see the statistics) with the initial password, if it doesn't exist
# yet. Sign in and change the password right away. Production needs at least 10
# characters; locally anything goes (e.g. admin / admin). Leave both unset for none.
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_INITIAL_PASSWORD=

# How long (ms) a disconnected player's seat is held before the game is abandoned.
RECONNECT_GRACE_MS=60000

# Browser origins allowed by the server's CORS policy. Use "*" to reflect any
# origin (LAN/dev), or a comma-separated allowlist (e.g. http://a:5173,http://b).
# In production it must be set, and "*" is refused.
CLIENT_ORIGIN=http://localhost:8080

# How the browser reaches the server. Leave VITE_SERVER_URL unset to derive it
# from the page's own address (works for localhost and LAN); set it to pin an
# explicit URL. VITE_SERVER_PORT overrides just the port when deriving (default 3001).
# VITE_SERVER_URL=http://localhost:3001
# VITE_SERVER_PORT=3001

# Search worker threads for the Aviator bot. Set it to the CPUs the server may
# really use (e.g. a 2-vCPU VPS: 1). Unset = a spare core each, at most 4,
# counted from the host's cores, which can exceed a container's CPU limit.
# NPC_WORKERS=1

# Reverse proxies in front of the server, so per-client rate limits see the real
# client address in X-Forwarded-For. 0 (default) = clients connect directly.
# Behind Caddy and the client's nginx (the VPS plan): 2. Too high a number lets
# a client fake its address and dodge the limits.
# TRUST_PROXY=0

# Password for the game-log database (PostgreSQL). Required by docker-compose.yml.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Recorded with every game log, to tell builds apart (e.g. GIT_SHA=$(git rev-parse --short HEAD)).
# GIT_SHA=dev
